→ Patching: sql_injection

  Before (SQL Injection):
# VULNERABLE: raw SQL string formatting                                                                  
    query = f"SELECT * FROM users WHERE username='{username}' AND password='{password}'"                 
    try:                                                                                                 
        db = get_db()                                                                                    
        user = db.execute(query).fetchone()                                                              
    except Exception as e:                                                                               
        return jsonify({"error": str(e), "query": query}), 500                                           

  After (SQL Injection):
# PATCHED: parameterized query — prevents SQL injection                                                  
    try:                                                                                                 
        db = get_db()                                                                                    
        user = db.execute(                                                                               
            "SELECT * FROM users WHERE username=? AND password=?",                                       
            (username, password)                                                                         
        ).fetchone()                                                                                     
    except Exception as e:                                                                               
        return jsonify({"error": "Database error"}), 500  # Do not leak error details                    

→ Patching: hardcoded_credentials
  ✓ Hardcoded credential replaced with env var + random fallback

→ Patching: broken_jwt

  Before (Broken JWT):
# VULNERABLE: options={"verify_signature": False} — accepts unsigned tokens                              
        payload = jwt.decode(token, options={"verify_signature": False}, algorithms=["HS256", "none"])   

  After (Broken JWT):
# PATCHED: enforce full signature verification, disallow alg:none                                        
        payload = jwt.decode(token, app.secret_key, algorithms=["HS256"])                                

→ Patching: command_injection

  Before (Command Injection):
# VULNERABLE: shell=True with user input (cross-platform ping syntax)                                    
    count_flag = "-n" if platform.system().lower() == "windows" else "-c"                                
    try:                                                                                                 
        result = subprocess.check_output(                                                                
            f"ping {count_flag} 1 {host}",                                                               
            shell=True,                                                                                  
            stderr=subprocess.STDOUT,                                                                    
            timeout=5                                                                                    
        )                                                                                                

  After (Command Injection):
# PATCHED: safe subprocess call with argument list (no shell=True)                                       
    # Validate host format before passing to subprocess                                                  
    import re as _re                                                                                     
    if not _re.match(r"^[a-zA-Z0-9._-]{1,253}$", host):                                                  
        return jsonify({"error": "Invalid host format"}), 400                                            
    count_flag = "-n" if platform.system().lower() == "windows" else "-c"                                
    try:                                                                                                 
        result = subprocess.check_output(                                                                
            ["ping", count_flag, "1", host],   # list form — no shell injection possible                 
            shell=False,                                                                                 
            stderr=subprocess.STDOUT,                                                                    
            timeout=5                                                                                    
        )                                                                                                

→ Hardening: runtime_config

  Before (Runtime hardening):
app.run(host="0.0.0.0", port=5000, debug=True)                                                           

  After (Runtime hardening):
app.run(host=os.environ.get("HOST", "127.0.0.1"),                                                        
            port=int(os.environ.get("PORT", "5001")),                                                    
            debug=False)  # PATCHED: debug disabled, bind configurable                                   

  Before (Seed dir fix):
    os.makedirs("files", exist_ok=True)                                                                  
    with open("files/readme.txt", "w") as f:                                                             
        f.write("Welcome to VulnApp! This is a safe file.\n")                                            

  After (Seed dir fix):
    # PATCHED: seed the same directory that /file serves from (module-relative)                          
    files_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "files")                        
    os.makedirs(files_dir, exist_ok=True)                                                                
    with open(os.path.join(files_dir, "readme.txt"), "w", encoding="utf-8") as f:                        
        f.write("Welcome to VulnApp! This is a safe file.\n")                                            

